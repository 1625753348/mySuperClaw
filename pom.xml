<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example.enterpriseagent</groupId>
    <artifactId>enterprise-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Enterprise Agent</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- 业务模块先构建，启动模块负责组装运行时。 -->
    <modules>
        <module>modules/access</module>
        <module>modules/intent-engine</module>
        <module>modules/decision</module>
        <module>modules/workflow-skill</module>
        <module>modules/agent-runtime</module>
        <module>modules/tool-gateway</module>
        <module>modules/event-bus</module>
        <module>modules/memory</module>
        <module>modules/infrastructure</module>
        <module>apps/agent-app</module>
    </modules>
</project>
